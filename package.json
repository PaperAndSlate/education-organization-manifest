{
  "name": "@paperandslate/eom-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Educational Organization Manifest reference implementation and standards repository.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.6.0",
  "engines": {
    "node": ">=24.17.0 <25",
    "pnpm": ">=10.6.0 <11"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "clean": "pnpm --recursive --if-present run clean",
    "dev": "pnpm --parallel --recursive --if-present run dev",
    "docs:build": "pnpm --filter @paperandslate/eom-docs build && pnpm --filter @paperandslate/eom-playground build",
    "docs:check": "tsx scripts/check-docs.ts",
    "dependency:check": "tsx scripts/check-dependencies.ts",
    "examples:build": "tsx scripts/build-example.ts examples/ecme-high/source examples/ecme-high/generated",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:types": "tsx scripts/generate-types.ts",
    "generate:docs": "tsx scripts/generate-schema-docs.ts",
    "generate:drift": "tsx scripts/check-generated-drift.ts",
    "prompts:check": "tsx scripts/check-prompts.ts",
    "lint": "tsx scripts/lint.ts",
    "license:check": "tsx scripts/check-license.ts",
    "release:check": "tsx scripts/check-release.ts",
    "release:prepare": "tsx scripts/generate-release-artifacts.ts",
    "schema:check": "tsx scripts/check-schemas.ts",
    "test": "tsx scripts/run-tests.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm format:check && pnpm schema:check && pnpm generate:drift && pnpm typecheck && pnpm test -- --runInBand && pnpm build && pnpm lint && pnpm verify:security && pnpm license:check && pnpm dependency:check && pnpm verify:determinism && pnpm verify:examples && pnpm docs:build && pnpm docs:check && pnpm release:check",
    "verify:determinism": "tsx scripts/check-determinism.ts",
    "verify:examples": "tsx scripts/check-examples.ts",
    "verify:security": "tsx scripts/security-check.ts",
    "eom": "tsx packages/cli/src/index.ts",
    "conformance": "tsx packages/cli/src/index.ts conformance examples/ecme-high/public --json"
  },
  "devDependencies": {
    "@paperandslate/eom-agentic": "workspace:*",
    "@paperandslate/eom-adapters": "workspace:*",
    "@paperandslate/eom-authority": "workspace:*",
    "@paperandslate/eom-cli": "workspace:*",
    "@paperandslate/eom-core": "workspace:*",
    "@paperandslate/eom-generator": "workspace:*",
    "@paperandslate/eom-linter": "workspace:*",
    "@paperandslate/eom-schema": "workspace:*",
    "@paperandslate/eom-signatures": "workspace:*",
    "@paperandslate/eom-testkit": "workspace:*",
    "@paperandslate/eom-validator": "workspace:*",
    "@types/node": "^24.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
