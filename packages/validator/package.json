{
  "name": "@paperandslate/eom-validator",
  "version": "1.0.0-rc.3",
  "description": "Structural and semantic validator for EOM publications.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@paperandslate/eom-authority": "workspace:*",
    "@paperandslate/eom-core": "workspace:*",
    "@paperandslate/eom-schema": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --declaration --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  }
}
