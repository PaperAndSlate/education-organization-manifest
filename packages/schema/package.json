{
  "name": "@paperandslate/eom-schema",
  "version": "0.1.0",
  "description": "Bundled EOM 1.0 JSON Schema 2020-12 catalog.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@paperandslate/eom-core": "workspace:*"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --declaration --declarationMap && node ../../scripts/copy-schema-assets.mjs packages/schema/dist/schemas",
    "typecheck": "tsc --noEmit",
    "lint": "true"
  }
}
