{
  "name": "@paperandslate/eom-testkit",
  "version": "0.1.0",
  "description": "Offline EOM conformance profiles and black-box publication runner.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@paperandslate/eom-core": "workspace:*",
    "@paperandslate/eom-linter": "workspace:*",
    "@paperandslate/eom-validator": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --declaration --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "true"
  }
}
