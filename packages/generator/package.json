{
  "name": "@paperandslate/eom-generator",
  "version": "1.0.0-rc.2",
  "description": "Offline-safe deterministic YAML-to-EOM publication generator.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@paperandslate/eom-agentic": "workspace:*",
    "@paperandslate/eom-config": "workspace:*",
    "@paperandslate/eom-core": "workspace:*",
    "@paperandslate/eom-linter": "workspace:*",
    "@paperandslate/eom-signatures": "workspace:*",
    "@paperandslate/eom-validator": "workspace:*",
    "yaml": "^2.8.1"
  },
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --declaration --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  }
}
