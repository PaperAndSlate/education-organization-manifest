{
  "name": "@paperandslate/eom-cli",
  "version": "1.0.0-rc.2",
  "description": "The eom command-line interface.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "eom": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@paperandslate/eom-agentic": "workspace:*",
    "@paperandslate/eom-adapters": "workspace:*",
    "@paperandslate/eom-authority": "workspace:*",
    "@paperandslate/eom-core": "workspace:*",
    "@paperandslate/eom-generator": "workspace:*",
    "@paperandslate/eom-linter": "workspace:*",
    "@paperandslate/eom-schema": "workspace:*",
    "@paperandslate/eom-signatures": "workspace:*",
    "@paperandslate/eom-validator": "workspace:*",
    "commander": "^14.0.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --declaration --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  }
}
