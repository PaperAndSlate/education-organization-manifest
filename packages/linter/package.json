{
  "name": "@paperandslate/eom-linter",
  "version": "0.1.0",
  "description": "Quality, freshness, and privacy linter for EOM publications.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@paperandslate/eom-core": "workspace:*",
    "@paperandslate/eom-validator": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --declaration --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "true"
  }
}
