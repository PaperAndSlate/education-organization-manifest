{
  "name": "@paperandslate/eom-core",
  "version": "1.0.0-rc.3",
  "description": "Offline-safe EOM parsing, URI, localization, and publication primitives.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ids": {
      "types": "./dist/ids.d.ts",
      "import": "./dist/ids.js",
      "default": "./dist/ids.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "default": "./dist/json.js"
    },
    "./findings": {
      "types": "./dist/findings.d.ts",
      "import": "./dist/findings.js",
      "default": "./dist/findings.js"
    },
    "./time": {
      "types": "./dist/time.d.ts",
      "import": "./dist/time.js",
      "default": "./dist/time.js"
    },
    "./fs-path": {
      "types": "./dist/fs-path.d.ts",
      "import": "./dist/fs-path.js",
      "default": "./dist/fs-path.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --outDir dist --rootDir src --declaration --declarationMap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings=0"
  }
}
