{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/config.schema.json",
  "title": "EOM authoring configuration",
  "type": "object",
  "required": ["project", "publisher", "source", "output"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "protocolVersion", "defaultLanguage"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "protocolVersion": { "const": "1.0" },
        "defaultLanguage": { "$ref": "common.schema.json#/$defs/bcp47" },
        "supportedLanguages": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/bcp47" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": ["origin", "manifestPath"],
      "properties": {
        "origin": { "$ref": "common.schema.json#/$defs/httpsUri" },
        "manifestPath": { "type": "string", "pattern": "^/" },
        "organizationId": { "$ref": "common.schema.json#/$defs/absoluteUri" },
        "organizationType": { "type": "string", "minLength": 1 },
        "organizationName": { "$ref": "common.schema.json#/$defs/localized" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["root", "modules"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "modules": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module", "patterns"],
            "properties": {
              "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "patterns": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["module", "patterns"],
            "properties": {
              "module": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "patterns": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "owner", "priority", "modules", "allowedPointers"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "owner": { "type": "string", "minLength": 1 },
              "priority": { "type": "integer", "minimum": 0 },
              "modules": {
                "type": "object",
                "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
                "additionalProperties": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "allowedPointers": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "pattern": "^/(?:[^~/]|~[01])*$" },
                "uniqueItems": true
              }
            },
            "additionalProperties": false
          }
        },
        "ownershipByDirectory": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "type": "string", "minLength": 1 },
        "canonicalJson": { "type": "boolean" },
        "prettyPrint": { "type": "boolean" },
        "sourceMaps": { "type": "boolean" },
        "buildManifest": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "validation": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "privacyLint": { "type": "boolean" },
        "privacyAcknowledgements": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "failOn": {
          "type": "array",
          "items": { "enum": ["error", "warning", "info"] },
          "uniqueItems": true
        },
        "warnOnMissingFreshness": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "properties": {
        "modified": { "$ref": "common.schema.json#/$defs/dateTime" },
        "expires": { "$ref": "common.schema.json#/$defs/dateTime" },
        "indexingPolicy": { "$ref": "manifest.schema.json#/$defs/indexingPolicy" },
        "notice": { "$ref": "common.schema.json#/$defs/localized" }
      },
      "additionalProperties": false
    },
    "signing": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "keyFile": { "type": "string", "minLength": 1 },
        "keyId": { "$ref": "common.schema.json#/$defs/absoluteUri" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": { "required": ["keyFile", "keyId"] }
        }
      ],
      "additionalProperties": false
    },
    "maxBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 }
  },
  "additionalProperties": false
}
