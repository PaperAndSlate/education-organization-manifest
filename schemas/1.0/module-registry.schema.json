{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/module-registry.schema.json",
  "title": "EOM module registry",
  "type": "object",
  "required": ["$schema", "specification", "version", "id", "canonical", "type", "status", "changeController", "lastReviewed", "modules"],
  "properties": {
    "$schema": { "const": "https://paperandslate.org/schemas/eom/1.0/module-registry.schema.json" },
    "specification": { "const": "https://paperandslate.org/spec/eom/1.0" },
    "version": { "const": "1.0" },
    "id": { "$ref": "common.schema.json#/$defs/absoluteUri" },
    "canonical": { "$ref": "common.schema.json#/$defs/httpsUri" },
    "type": { "const": "module-registry" },
    "status": { "enum": ["working-draft", "registered", "deprecated"] },
    "changeController": { "$ref": "common.schema.json#/$defs/absoluteUri" },
    "lastReviewed": { "$ref": "common.schema.json#/$defs/date" },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/module" }
    },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false,
  "$defs": {
    "module": {
      "type": "object",
      "required": ["moduleUri", "shortName", "title", "description", "resourceType", "schema", "currentVersion", "compatibleProtocolVersions", "status", "changeController", "privacyClass", "freshness", "collection", "example", "conformanceProfile", "extensionPoints", "mappings", "lastReviewed"],
      "properties": {
        "moduleUri": { "$ref": "common.schema.json#/$defs/absoluteUri" },
        "shortName": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "$ref": "common.schema.json#/$defs/localized" },
        "description": { "$ref": "common.schema.json#/$defs/localized" },
        "resourceType": { "type": "string", "minLength": 1 },
        "schema": { "$ref": "common.schema.json#/$defs/httpsUri" },
        "currentVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "compatibleProtocolVersions": { "type": "array", "items": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" }, "minItems": 1, "uniqueItems": true },
        "status": { "enum": ["working-draft", "stable", "experimental", "deprecated"] },
        "changeController": { "$ref": "common.schema.json#/$defs/absoluteUri" },
        "privacyClass": { "type": "string", "minLength": 1 },
        "freshness": { "type": "string", "minLength": 1 },
        "collection": { "enum": ["single", "items", "paged", "delegated"] },
        "example": { "type": "string", "minLength": 1 },
        "conformanceProfile": { "$ref": "common.schema.json#/$defs/absoluteUri" },
        "extensionPoints": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/absoluteUri" }, "uniqueItems": true },
        "mappings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "lastReviewed": { "$ref": "common.schema.json#/$defs/date" }
      },
      "additionalProperties": false
    }
  }
}
