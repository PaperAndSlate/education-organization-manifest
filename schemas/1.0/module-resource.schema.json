{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/module-resource.schema.json",
  "title": "EOM public module resource envelope",
  "type": "object",
  "required": [
    "$schema",
    "specification",
    "version",
    "id",
    "type",
    "canonical",
    "subjects",
    "items"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "specification": { "const": "https://paperandslate.org/spec/eom/1.0" },
    "version": { "const": "1.0" },
    "id": { "$ref": "common.schema.json#/$defs/absoluteUri" },
    "type": { "type": "string", "minLength": 1 },
    "canonical": { "$ref": "common.schema.json#/$defs/httpsUri" },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/absoluteUri" }
    },
    "publisher": { "$ref": "common.schema.json#/$defs/publisher" },
    "title": { "$ref": "common.schema.json#/$defs/localized" },
    "description": { "$ref": "common.schema.json#/$defs/localized" },
    "defaultLanguage": { "$ref": "common.schema.json#/$defs/bcp47" },
    "supportedLanguages": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/bcp47" },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "items": { "type": "object", "minProperties": 1 }
    },
    "next": { "$ref": "common.schema.json#/$defs/httpsUri" },
    "modified": { "$ref": "common.schema.json#/$defs/dateTime" },
    "expires": { "$ref": "common.schema.json#/$defs/dateTime" },
    "effective": { "$ref": "common.schema.json#/$defs/period" },
    "catalogVersion": { "$ref": "common.schema.json#/$defs/catalogVersion" },
    "releaseStatus": {
      "enum": ["draft", "proposed", "active", "historical", "retired"]
    },
    "license": { "$ref": "common.schema.json#/$defs/absoluteUri" },
    "provenance": { "type": "array", "items": { "$ref": "provenance.schema.json" } },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "additionalProperties": false
}
