{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/provenance.schema.json",
  "title": "EOM resource, object, or field provenance record",
  "type": "object",
  "required": ["id", "scope", "source", "observedAt"],
  "properties": {
    "type": { "const": "provenance" },
    "id": {
      "$ref": "common.schema.json#/$defs/absoluteUri"
    },
    "scope": {
      "enum": ["resource", "object", "field"]
    },
    "targetResource": {
      "$ref": "common.schema.json#/$defs/absoluteUri"
    },
    "targetObjectId": {
      "$ref": "common.schema.json#/$defs/absoluteUri"
    },
    "targetPointers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?:|(?:/(?:[^~/]|~[01])*)+)$"
      }
    },
    "source": {
      "type": "object",
      "required": ["uri", "type"],
      "properties": {
        "uri": {
          "$ref": "common.schema.json#/$defs/absoluteUri"
        },
        "type": {
          "enum": [
            "organization-publication",
            "organization-website",
            "organization-api",
            "government-registry",
            "government-statistical-dataset",
            "standards-body",
            "vendor-authorized-feed",
            "human-submission",
            "agent-extraction",
            "foundation-derived",
            "mirror",
            "unknown",
            "official-website",
            "official-document",
            "public-dataset",
            "government-record",
            "partner-feed",
            "human-review",
            "inference",
            "other"
          ]
        },
        "publisher": {
          "$ref": "common.schema.json#/$defs/entityRef"
        },
        "license": {
          "$ref": "common.schema.json#/$defs/absoluteUri"
        }
      },
      "additionalProperties": false
    },
    "observedAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "retrievedAt": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "effective": {
      "$ref": "common.schema.json#/$defs/period"
    },
    "assertedBy": {
      "$ref": "common.schema.json#/$defs/absoluteUri"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "transformation": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "$ref": "common.schema.json#/$defs/absoluteUri"
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+=:.*:$"
    },
    "verificationStatus": {
      "enum": [
        "asserted",
        "extracted",
        "reviewed",
        "verified-against-source",
        "disputed",
        "stale",
        "withdrawn"
      ]
    },
    "verification": {
      "enum": ["unverified", "automated", "human-reviewed", "publisher-confirmed", "disputed"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "scope": { "const": "resource" } } },
      "then": { "required": ["targetResource"] }
    },
    {
      "if": { "properties": { "scope": { "const": "object" } } },
      "then": { "required": ["targetObjectId"] }
    },
    {
      "if": { "properties": { "scope": { "const": "field" } } },
      "then": { "required": ["targetResource", "targetPointers"] }
    }
  ],
  "additionalProperties": false
}
