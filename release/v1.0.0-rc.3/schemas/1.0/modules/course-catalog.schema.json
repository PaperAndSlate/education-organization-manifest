{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/modules/course-catalog.schema.json",
  "title": "EOM course catalog",
  "allOf": [
    { "$ref": "../module-resource.schema.json" },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://paperandslate.org/schemas/eom/1.0/modules/course-catalog.schema.json"
        },
        "type": { "const": "course-catalog" },
        "items": {
          "type": "array",
          "items": { "$ref": "module-items.schema.json#/$defs/course" }
        }
      }
    }
  ]
}
