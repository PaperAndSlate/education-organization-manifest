{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/modules/job-catalog.schema.json",
  "title": "EOM public job catalog",
  "allOf": [
    { "$ref": "../module-resource.schema.json" },
    {
      "type": "object",
      "properties": {
        "$schema": {
          "const": "https://paperandslate.org/schemas/eom/1.0/modules/job-catalog.schema.json"
        },
        "type": { "const": "job-catalog" },
        "items": { "type": "array", "items": { "$ref": "module-items.schema.json#/$defs/job" } }
      }
    }
  ]
}
