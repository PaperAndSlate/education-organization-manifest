{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/organization-profile.schema.json",
  "title": "EOM organization profile",
  "type": "object",
  "required": [
    "$schema",
    "specification",
    "version",
    "id",
    "type",
    "canonical",
    "name",
    "organizationType"
  ],
  "properties": {
    "$schema": {
      "const": "https://paperandslate.org/schemas/eom/1.0/organization-profile.schema.json"
    },
    "specification": {
      "const": "https://paperandslate.org/spec/eom/1.0"
    },
    "version": {
      "const": "1.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/absoluteUri"
    },
    "type": {
      "const": "organization-profile"
    },
    "canonical": {
      "$ref": "common.schema.json#/$defs/httpsUri"
    },
    "name": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "organizationType": {
      "type": "string",
      "minLength": 1
    },
    "alternateNames": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/localized"
      }
    },
    "description": {
      "$ref": "common.schema.json#/$defs/localized"
    },
    "website": {
      "$ref": "common.schema.json#/$defs/httpsUri"
    },
    "parent": {
      "$ref": "common.schema.json#/$defs/entityRef"
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/identifier"
      }
    },
    "address": {
      "$ref": "common.schema.json#/$defs/address"
    },
    "contacts": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "campuses": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "departments": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/entityRef"
      },
      "uniqueItems": true
    },
    "languages": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/bcp47"
      },
      "uniqueItems": true
    },
    "status": {
      "enum": ["active", "planned", "closed", "merged", "unknown"]
    },
    "founded": {
      "anyOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "integer", "minimum": 1 }]
    },
    "defaultLanguage": {
      "$ref": "common.schema.json#/$defs/bcp47"
    },
    "supportedLanguages": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/bcp47"
      },
      "uniqueItems": true
    },
    "modified": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "expires": {
      "$ref": "common.schema.json#/$defs/dateTime"
    },
    "provenance": {
      "type": "array",
      "items": {
        "$ref": "provenance.schema.json"
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "additionalProperties": false
}
