{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperandslate.org/schemas/eom/1.0/mapping.schema.json",
  "title": "EOM interoperability mapping registry",
  "type": "object",
  "required": ["type", "version", "mappings"],
  "properties": {
    "type": { "const": "mapping-registry" },
    "version": { "const": "1.0" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "sourceFormat",
          "sourceVersion",
          "targetFormat",
          "direction",
          "status",
          "modules",
          "publicFieldAllowlist",
          "transformations",
          "lossiness",
          "provenance",
          "privacy",
          "certificationClaim"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/absoluteUri" },
          "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
          "sourceFormat": { "type": "string", "minLength": 1 },
          "sourceVersion": { "type": "string", "minLength": 1 },
          "targetFormat": { "const": "eom-authoring-candidate" },
          "direction": { "enum": ["import", "export", "bidirectional"] },
          "status": { "enum": ["experimental", "preview", "stable", "deprecated"] },
          "modules": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "publicFieldAllowlist": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "transformations": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "lossiness": {
            "type": "object",
            "required": ["exact", "approximate", "omitted"],
            "properties": {
              "exact": { "type": "array", "items": { "type": "string" } },
              "approximate": { "type": "array", "items": { "type": "string" } },
              "omitted": { "type": "array", "items": { "type": "string" } }
            },
            "additionalProperties": false
          },
          "provenance": { "enum": ["claim-ledger", "source-digest-only"] },
          "privacy": {
            "type": "object",
            "required": ["allowlist", "prohibitedFields", "reviewRequired"],
            "properties": {
              "allowlist": { "type": "array", "items": { "type": "string" } },
              "prohibitedFields": { "type": "array", "items": { "type": "string" } },
              "reviewRequired": { "type": "boolean" }
            },
            "additionalProperties": false
          },
          "fixture": { "type": "string", "minLength": 1 },
          "maintainer": { "type": "string", "minLength": 1 },
          "reviewedAt": { "$ref": "common.schema.json#/$defs/dateTime" },
          "certificationClaim": { "const": false },
          "notes": { "type": "string", "maxLength": 2000 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
